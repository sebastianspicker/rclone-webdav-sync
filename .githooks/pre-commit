#!/usr/bin/env bash
# pre-commit - shfmt + shellcheck over the staged shell files.
# Enable with `make hooks` (sets core.hooksPath to .githooks); bypass a
# single commit with `git commit --no-verify`. Checks the working-tree copy
# of each staged file, which matches the index unless it was edited again
# after `git add`.
set -uo pipefail

files=()
while IFS= read -r -d '' path; do
  case "$path" in
    bin/sciebo | *.sh | .githooks/*) files+=("$path") ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
((${#files[@]})) || exit 0

status=0
if command -v shfmt >/dev/null 2>&1; then
  shfmt -i 2 -ci -d "${files[@]}" || status=1
else
  printf 'pre-commit: shfmt not found; skipping\n' >&2
fi
if command -v shellcheck >/dev/null 2>&1; then
  shellcheck -x -P SCRIPTDIR "${files[@]}" || status=1
else
  printf 'pre-commit: shellcheck not found; skipping\n' >&2
fi
if ((status)); then
  printf 'pre-commit: fix the findings above (shfmt -i 2 -ci -w FILE) or commit with --no-verify\n' >&2
fi
exit "$status"
