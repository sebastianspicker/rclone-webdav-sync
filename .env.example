# Copy to .env (gitignored) and fill in, or let `sciebo setup` prompt you.
#
# SCIEBO_URL is the base URL of your institution's sciebo instance
# (see https://docs.sciebo.de/docs/getting-started/webinterface/serverliste/).
# `sciebo setup` normalizes it to
#   https://<host>/remote.php/dav/files/<user>/
# which is required for Nextcloud chunked uploads.
#
# SCIEBO_USER is your sciebo ID: <localid>@<scope>, e.g. alice@uni-muenster.de
#
# SCIEBO_APP_PASSWORD is an app password (Settings > Security > Devices &
# sessions), required when two-factor authentication is enabled. Never use
# your main sciebo password here.

SCIEBO_URL="https://uni-muenster.sciebo.de"
SCIEBO_USER=""
SCIEBO_APP_PASSWORD=""
