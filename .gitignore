# Credentials and local overrides (never commit these)
.env
.env.*
!.env.example
config/settings.local.env
# restic repository password file (KEYCHAIN=0 fallback); never commit it
config/backup.key
config/profiles/*/backup.key
# Named profiles hold per-user settings and secrets (settings.local.env)
/config/profiles/

# Generated configuration and runtime state
config/sources.generated.conf
/state/

# Logs and atomic-write debris
*.log
*.tmp.*
*.bak
*.orig

# Python bytecode from `make lint` / `make screenshots`
__pycache__/
*.pyc

# OS and editor debris
.DS_Store
._*
*.swp
*~
.idea/
.vscode/

# Local agent workspace and settings (kept out of the published repo)
/.agents/
/.claude/
/AGENTS.md
/CLAUDE.md
/docs/plans/

# Build output and archives (`make dist`, `sciebo support --output`)
/dist/
*.tar.gz

# Internal test suite (not published)
/tests/

# Private task and integration planning records (public known issues stay tracked)
/.codex/
/THINGS_TO_DO_LEDGER.md
/ALPHA_AUDIT_LEDGER.md
/ALPHA_AUDIT_REPORT.md
/ALPHA_IMPLEMENTATION_LEDGER.md
/ALPHA_PR_DESCRIPTION.md
/RESTIC_INTEGRATION_LEDGER.md
/RESTIC_INTEGRATION_PLAN.md
/REPO_AUDIT_LEDGER.md
/CODEX.md
/GEMINI.md
