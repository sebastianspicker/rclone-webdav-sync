#!/usr/bin/env bash
# nextcloudcmd compatibility shim: forward to `sciebo nextcloudcmd` so
# scripts and cron entries that call scripts/nextcloudcmd keep working.
set -euo pipefail
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec bash "${PROJECT_DIR}/bin/sciebo" nextcloudcmd "$@"
