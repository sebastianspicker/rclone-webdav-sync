# Shared defaults for the rclone-sciebo tooling.
#
# Do not put credentials in this file. The remote (including the obscured
# app password) lives in the rclone config created by `sciebo setup`.
#
# Precedence (low to high): these defaults < environment <
# config/settings.local.env, so every value can be overridden by exporting
# it or by copying settings.local.env.example to settings.local.env.

# rclone remote name and remote base directory (relative to the remote root).
: "${RCLONE_REMOTE:=sciebo}"
: "${REMOTE_BASE:=backup}"
: "${RCLONE_CONFIG:=${HOME}/.config/rclone/rclone.conf}"

# Transfer tuning. Deliberately gentle: sciebo asks users to avoid
# hammering the system and to keep sync intervals large.
: "${TRANSFERS:=2}"
: "${CHECKERS:=4}"
: "${TPSLIMIT:=8}"
: "${RETRIES:=3}"
: "${LOW_LEVEL_RETRIES:=10}"
: "${TIMEOUT:=10m}"
: "${CONTIMEOUT:=30s}"
: "${STATS:=30s}"
: "${LOG_LEVEL:=INFO}"

# Bisync: how to resolve conflicts (none|newer|older|larger|smaller).
: "${BISYNC_CONFLICT_RESOLVE:=newer}"

# Housekeeping.
: "${LOG_RETENTION_DAYS:=14}"
: "${CHUNK_CLEANUP_MIN_AGE:=24h}"

# launchd schedule (daily at SCHEDULE_HOUR:SCHEDULE_MINUTE).
: "${LAUNCHD_LABEL:=de.rclone-sciebo.sync}"
: "${SCHEDULE_HOUR:=12}"
: "${SCHEDULE_MINUTE:=30}"

# Folder chooser (`sciebo folders`).
: "${FOLDERS_SCAN_DEPTH:=2}"
: "${DEFAULT_PAIR_MODE:=bisync}"
: "${FOLDERS_LOCAL_ROOT:=${HOME}/sciebo}"

# On-demand mounts (`sciebo mount`); never scheduled automatically.
: "${MOUNT_ROOT:=${HOME}/sciebo-mount}"
: "${MOUNT_CACHE_MAX_SIZE:=5G}"
: "${MOUNT_EXTRA_FLAGS:=}"
