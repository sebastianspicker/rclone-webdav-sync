# Default settings for the sciebo tooling.
#
# These values ship with the project. To change one, don't edit this file:
# override it in config/settings.local.env (gitignored) or export it for a
# single run. See the Configuration section of the README for the precedence
# rules. Do not put credentials here; the app password belongs in the rclone
# config that `sciebo setup` writes.

# Where the remote and its base folder live. Sources are relative to
# <RCLONE_REMOTE>:<REMOTE_BASE>/.
: "${RCLONE_REMOTE:=sciebo}"
: "${REMOTE_BASE:=backup}"
: "${RCLONE_CONFIG:=${HOME}/.config/rclone/rclone.conf}"

# Transfer tuning. Deliberately gentle: sciebo asks users to avoid hammering
# the service and to keep sync intervals large.
: "${TRANSFERS:=2}"
: "${CHECKERS:=4}"
: "${TPSLIMIT:=8}"
: "${RETRIES:=3}"
: "${LOW_LEVEL_RETRIES:=10}"
: "${TIMEOUT:=10m}"
: "${CONTIMEOUT:=30s}"
: "${STATS:=30s}"
: "${LOG_LEVEL:=INFO}"

# Optional resilience and resume. RETRIES_SLEEP is rclone's delay between
# high-level retries (--retries-sleep, e.g. 5s; empty keeps rclone's default).
# TRANSFER_PARTIAL=1 keeps interrupted downloads for resume (--partial) and
# TRANSFER_INPLACE=1 writes straight to the destination (--inplace) instead
# of a temp file plus rename.
: "${RETRIES_SLEEP:=}"
: "${TRANSFER_PARTIAL:=0}"
: "${TRANSFER_INPLACE:=0}"

# How `bisync` settles conflicts: none, newer, older, larger, or smaller.
: "${BISYNC_CONFLICT_RESOLVE:=newer}"
# Conflict loser naming. `num` renames the loser to
# "<name>.<suffix><N>" (for example "notes.txt.(conflicted copy)1");
# `BISYNC_CONFLICT_SUFFIX` is the text in that name. Conflicts are synced
# to both sides, like rclone itself does; `sciebo sync` reports them.
: "${BISYNC_CONFLICT_LOSER:=num}"
: "${BISYNC_CONFLICT_SUFFIX:=(conflicted copy)}"
# Bisync resilience (requires rclone >= RCLONE_MIN_VERSION). `recover`
# resumes interrupted runs, `resilient` retries recoverable errors instead
# of demanding --resync, `max-lock` expires a stale bisync workdir lock,
# and `resync-mode newer` makes a first-time resync honor
# BISYNC_CONFLICT_RESOLVE instead of silently preferring the local side.
: "${BISYNC_RESILIENT:=1}"
: "${BISYNC_RECOVER:=1}"
: "${BISYNC_MAX_LOCK:=2m}"
: "${BISYNC_RESYNC_MODE:=newer}"

# Minimum rclone version; doctor and sync refuse older binaries.
: "${RCLONE_MIN_VERSION:=1.69}"

# Optional extra transfer flags (0 = off): empty directories,
# rename detection, and a delete cap (-1 = unlimited).
: "${CREATE_EMPTY_SRC_DIRS:=0}"
: "${TRACK_RENAMES:=0}"
: "${MAX_DELETE:=-1}"

# Optional bandwidth limits, e.g. BW_LIMIT_UP=2M and BW_LIMIT_DOWN=5M;
# empty uses rclone's default (unlimited).
: "${BW_LIMIT_UP:=}"
: "${BW_LIMIT_DOWN:=}"

# Nextcloud upload chunk size (rclone SizeSuffix, e.g. 100Mi). Empty uses
# rclone's default; `sciebo setup`/`doctor` may fill it from the server
# capabilities cache.
: "${CHUNK_SIZE:=}"

# Store the app password in the platform Keychain (KEYCHAIN=1) instead of the
# reversible obscured value in the rclone config. The fallback (0, or no usable
# backend) keeps the classic rclone config behavior.
: "${KEYCHAIN:=1}"
: "${KEYCHAIN_SERVICE:=rclone-sciebo}"

# How long a cached OCS capabilities probe stays fresh, in seconds.
: "${CAPABILITIES_MAX_AGE:=86400}"

# Notifications: NOTIFY=1 sends desktop notifications on failures;
# NOTIFY_SUCCESS=1 also reports successful runs.
: "${NOTIFY:=1}"
: "${NOTIFY_SUCCESS:=0}"

# Housekeeping thresholds: log retention, how old an abandoned chunk
# upload must be before `sciebo cleanup --uploads` may delete it, and how
# old orphaned state (bisync dirs, mount records, temp files) must be
# before `sciebo cleanup --state` may remove it.
: "${LOG_RETENTION_DAYS:=14}"
: "${CHUNK_CLEANUP_MIN_AGE:=24h}"
: "${STATE_CLEANUP_MIN_AGE:=24h}"

# launchd agent. By default it runs a quiet sync once a day at
# SCHEDULE_HOUR:SCHEDULE_MINUTE. Set SCHEDULE_INTERVAL (seconds) to run on
# an interval instead, SCHEDULE_JITTER (seconds) to add a random delay, and
# SCHEDULE_WATCH_PATH to also trigger a run when that path changes.
: "${LAUNCHD_LABEL:=de.rclone-sciebo.sync}"
: "${SCHEDULE_HOUR:=12}"
: "${SCHEDULE_MINUTE:=30}"
: "${SCHEDULE_INTERVAL:=}"
: "${SCHEDULE_JITTER:=0}"
: "${SCHEDULE_WATCH_PATH:=}"

# Folder picker (`sciebo folders`): how deep to scan the remote, which
# direction to suggest, and where suggested local folders go.
: "${FOLDERS_SCAN_DEPTH:=2}"
: "${DEFAULT_PAIR_MODE:=bisync}"
: "${FOLDERS_LOCAL_ROOT:=${HOME}/sciebo}"

# On-demand mounts (`sciebo mount`), always started by hand, never scheduled.
# MOUNT_FILTERS applies the clutter list (and a pair filter when the folder
# matches a configured source); MOUNT_NO_SYNC honors .nosync markers.
: "${MOUNT_ROOT:=${HOME}/sciebo-mount}"
: "${MOUNT_CACHE_MAX_SIZE:=5G}"
: "${MOUNT_FILTERS:=1}"
: "${MOUNT_NO_SYNC:=1}"
: "${MOUNT_EXTRA_FLAGS:=}"

# Direct HTTP calls (share, notifications, activity, presence, lock, and the
# trashbin/version operations) use these for the curl timeout and retries.
: "${HTTP_TIMEOUT:=30}"
: "${HTTP_RETRIES:=2}"
# HTTP_RETRY_DELAY is the seconds curl waits between those retries.
# HTTP_FOLLOW_REDIRECTS=1 makes GET/HEAD follow up to HTTP_MAX_REDIRS
# redirects (writes leave a 3xx for the caller, so a body is never silently
# dropped).
: "${HTTP_RETRY_DELAY:=1}"
: "${HTTP_FOLLOW_REDIRECTS:=1}"
: "${HTTP_MAX_REDIRS:=5}"

# Accept invalid TLS certificates (self-signed setups): rclone gets
# --no-check-certificate, curl gets --insecure. Also available per run as
# the global `--trust` flag. Off by default.
: "${TLS_INSECURE:=0}"

# Mutual TLS and custom trust (desktop-client parity). CLIENT_CERT and
# CLIENT_KEY are PEM files for the client certificate and its private key;
# CLIENT_KEY_PASSWORD is the optional plaintext passphrase for an encrypted
# CLIENT_KEY (rclone's --client-pass expects an obscured value, so sciebo
# obscures it before use). CA_CERT is a PEM bundle used to verify the server
# instead of the system trust store. USER_AGENT overrides the HTTP
# User-Agent; empty keeps the rclone or curl default. Paths are validated
# only when set; all are empty by default.
: "${CLIENT_CERT:=}"
: "${CLIENT_KEY:=}"
: "${CLIENT_KEY_PASSWORD:=}"
: "${CA_CERT:=}"
: "${USER_AGENT:=}"

# Hidden files: 0 syncs dot-files and dot-directories (the desktop client
# behavior); 1 excludes them, which is the nextcloudcmd default.
: "${SKIP_HIDDEN:=0}"

# Conflict handling. The Nextcloud desktop client keeps conflict copies on
# the machine that produced them; CONFLICT_UPLOAD=0 does the same by
# excluding them from uploads. CONFLICT_PATTERN is the substring
# `sciebo conflicts` looks for in local file names.
: "${CONFLICT_UPLOAD:=0}"
: "${CONFLICT_PATTERN:=conflicted copy}"

# Ask before downloading more than this size in one pull/bisync source
# (rclone SizeSuffix, e.g. 10G); empty disables the guard. ASK_DOWNLOAD_SIZE
# controls whether a TTY run may confirm interactively; non-interactive runs
# skip the source unless `sync --yes` is given.
: "${MAX_DOWNLOAD_SIZE:=}"
: "${ASK_DOWNLOAD_SIZE:=1}"

# Failure blacklist (like the desktop client's three-strikes rule). A path
# that errors BLACKLIST_MAX_FAILS times is excluded from later runs until
# `sciebo retry` clears it. 0 disables the tracking entirely.
: "${BLACKLIST_ENABLED:=1}"
: "${BLACKLIST_MAX_FAILS:=3}"

# Preserve overwritten and deleted local files on `pull` runs under this
# directory (rclone --backup-dir). Empty disables the copies.
: "${BACKUP_DIR:=}"

# Per-source run history for `sciebo status --history`: how many records to
# keep per source. 0 disables the history files.
: "${HISTORY_MAX_ENTRIES:=50}"

# How many sources one `sciebo sync` run processes at the same time. The
# default 1 keeps sciebo's deliberately gentle behavior; raise it only if
# the server can take the extra connections.
: "${MAX_PARALLEL_SOURCES:=1}"

# `cleanup --logs` rotates a log file larger than this (rclone SizeSuffix,
# e.g. 5M) to <name>.1 before age-based deletion; empty disables rotation.
: "${LOG_MAX_BYTES:=5M}"

# How old a file must be before `cleanup --junk` may delete it. The junk
# patterns live in config/filters/fleeting.txt.
: "${JUNK_CLEANUP_MIN_AGE:=24h}"

# Automatic sync (`sciebo watch`): poll interval and debounce in seconds,
# the local change-detection backend (auto picks fswatch or inotifywait when
# installed, else a portable poll), and an optional remote poll interval
# (0 disables remote-change detection).
: "${WATCH_INTERVAL:=60}"
: "${WATCH_DEBOUNCE:=10}"
: "${WATCH_REMOTE_INTERVAL:=0}"
: "${WATCH_BACKEND:=auto}"

# Scheduler: 1 makes `schedule install` start the agent at login/boot, and
# SCHEDULE_PROFILES lists extra profiles to render one agent each for
# (comma or space separated; empty means only the active profile).
: "${SCHEDULE_AT_LOGIN:=0}"
: "${SCHEDULE_PROFILES:=}"

# Bandwidth timetable for rclone (e.g. "Mon-Fri 08:00,2M Mon-Fri 18:00,off").
# Takes precedence over BW_LIMIT_UP/BW_LIMIT_DOWN when set; `sciebo limit`
# writes a runtime marker that takes precedence over both until it expires.
: "${BW_SCHEDULE:=}"

# Metered networks: allow, ask, or skip sync runs on a metered connection.
# METERED_SSIDS lists Wi-Fi names treated as metered on top of the OS report.
: "${METERED_POLICY:=allow}"
: "${METERED_SSIDS:=}"

# Disk space guards (empty disables). The desktop client uses 512M/1G:
# MIN_FREE_SPACE aborts a run when the destination filesystem is below it,
# FREE_SPACE_DOWNLOAD skips pull/bisync downloads that would fill below it.
: "${MIN_FREE_SPACE:=}"
: "${FREE_SPACE_DOWNLOAD:=}"

# Warn before a run when the server quota is at or above this percentage
# used (integer 0-100; 0, the default, disables the warning). The quota is
# read once per run with `rclone about --json`; a probe error only warns.
: "${QUOTA_WARN_PERCENT:=0}"

# Proxy: PROXY is an explicit proxy URL; PROXY_DIRECT=1 ignores the
# HTTP_PROXY/HTTPS_PROXY environment for rclone and curl. Empty PROXY keeps
# the standard environment variables.
: "${PROXY:=}"
: "${PROXY_DIRECT:=0}"

# Filters: FILTER_SERVER_SYNC=1 layers the fetched server sync-exclude list
# under every source; SERVER_EXCLUDE_MAX_AGE is when `doctor` calls the
# cache stale, BIG_FOLDER_SIZE notifies about large unconfigured remote
# folders (empty disables).
: "${FILTER_SERVER_SYNC:=0}"
: "${SERVER_EXCLUDE_MAX_AGE:=604800}"
: "${BIG_FOLDER_SIZE:=}"
# How long a big-folder scan is reused before notifying scans the remote
# again (duration, e.g. 30m or 2h; 0 disables the cache and always scans).
: "${BIGFOLDER_SCAN_TTL:=1h}"

# Failure blacklist: count (three-strikes, cleared with `sciebo retry`) or
# backoff (the desktop client's exponential retry between the two bounds).
: "${BLACKLIST_MODE:=count}"
: "${BLACKLIST_TIME_MIN:=25}"
: "${BLACKLIST_TIME_MAX:=86400}"

# 0 passes --disable-http2 to rclone (the desktop client default); 1 keeps
# rclone's HTTP/2 default.
: "${HTTP2_ENABLED:=1}"

# Server extras: result limits for search, recent, comments, file activity,
# and the avatar size in pixels.
: "${SEARCH_LIMIT:=20}"
: "${RECENT_LIMIT:=50}"
: "${AVATAR_SIZE:=128}"
: "${COMMENTS_LIMIT:=50}"
: "${FILE_ACTIVITY_LIMIT:=50}"

# `sciebo download` writes a bare `download REMOTE` here (empty = the current
# directory); `sciebo preview` requests this many pixels per side and writes
# the image to DEFAULT_PREVIEW_FILE when --output is omitted.
: "${DOWNLOAD_DIR:=}"
: "${PREVIEW_SIZE:=256}"
: "${DEFAULT_PREVIEW_FILE:=./preview}"

# rclone crypt remote created by `setup --crypt`; empty derives
# "<RCLONE_REMOTE>-crypt".
: "${CRYPT_REMOTE:=}"

# Desktop-parity notification filters: NOTIFY_APPS is an allowlist of
# notification apps (empty = all), NOTIFY_TYPES an allowlist of object types
# (empty = all); both accept comma, space, or colon separated names.
# NOTIFY_WATCH_INTERVAL is the default poll interval for `notifications
# --watch`, in seconds.
: "${NOTIFY_APPS:=}"
: "${NOTIFY_TYPES:=}"
: "${NOTIFY_WATCH_INTERVAL:=60}"

# Desktop-parity folder policies. BIG_FOLDER_POLICY applies when the folder
# picker or a sync finds a remote folder larger than BIG_FOLDER_SIZE:
# warn, ask (confirmation on a TTY), or skip. BIG_FOLDER_EXISTING_POLICY
# applies to already-configured sources that grew past BIG_FOLDER_SIZE:
# warn, skip, or allow.
: "${BIG_FOLDER_POLICY:=ask}"
: "${BIG_FOLDER_EXISTING_POLICY:=warn}"

# External storages mounted by the server (detected through the oc:permissions
# "M" flag): allow, warn, ask, or skip before a sync touches them.
: "${EXTERNAL_STORAGE_POLICY:=ask}"

# Delete guard, like promptDeleteAllFiles/deleteFilesThreshold: when a run
# would delete more than DELETE_FILES_THRESHOLD files, ASK_DELETE=1 prompts on
# a TTY and aborts otherwise (a non-interactive run needs `sync --yes`).
: "${DELETE_FILES_THRESHOLD:=100}"
: "${ASK_DELETE:=1}"

# moveToTrash: move locally deleted/overwritten files on pull/bisync runs into
# LOCAL_TRASH_DIR instead of deleting them (uses rclone --backup-dir).
# Empty LOCAL_TRASH_DIR derives "<state>/trash".
: "${MOVE_TO_TRASH:=0}"
: "${LOCAL_TRASH_DIR:=}"

# Symbolic links: skip (the desktop client behavior), follow (dereference), or
# translate (rclone .rclonelink files).
: "${SYMLINK_POLICY:=skip}"

# Names the desktop client never syncs: warn, exclude (skip them), or allow
# (current rclone behavior). Applies to Windows-invalid names.
: "${INVALID_NAME_POLICY:=exclude}"

# Case-only collisions (two names that differ only by case, ignoring unicode
# form): warn, exclude, or rename (quarantine the local copy with a
# "(case conflict)" suffix).
: "${CASE_CLASH_POLICY:=exclude}"
# Opt-in online case-clash scan: 1 lists each source's remote subtree with
# `rclone lsf -R` during the sync preflight and applies CASE_CLASH_POLICY to
# remote clashes too (a full remote listing is expensive, so this is off by
# default). Remote paths are never renamed; warn reports, exclude/rename
# exclude the losing path.
: "${CASE_CLASH_REMOTE_SCAN:=0}"

# Server-side end-to-end encrypted folders are opaque to rclone/WebDAV:
# warn, exclude, or allow (downloads the encrypted blobs).
: "${E2EE_POLICY:=exclude}"

# Compare transfers by checksum where the server supports it (rclone
# --checksum; bisync --compare size,modtime,checksum). Off by default.
: "${CHECKSUM:=0}"

# Proxy mode: system (HTTP(S)_PROXY and PROXY), none (ignore them), http, or
# socks5 (both use PROXY; http also honors PROXY_DIRECT).
: "${PROXY_TYPE:=system}"

# Upload chunk bounds. CHUNK_SIZE is clamped to MIN_CHUNK_SIZE/
# MAX_CHUNK_SIZE, both rclone SizeSuffix values (e.g. 5Mi, 100Mi). Empty
# bounds disable the clamp.
: "${MIN_CHUNK_SIZE:=}"
: "${MAX_CHUNK_SIZE:=}"

# The desktop client's target chunk upload duration, in milliseconds (the
# shipped example 60000 is 60s; an s/m/h/d suffix is also accepted). rclone
# uploads with one fixed chunk size, so when CHUNK_SIZE is unset this is
# combined with the effective upload throughput to derive a run-level chunk
# before the run: chunk = throughput * duration, capped at the server's
# maximum and the bounds above. Empty (or without a throughput) keeps the
# server capability maximum.
: "${TARGET_CHUNK_UPLOAD_DURATION:=}"

# Upload throughput used with TARGET_CHUNK_UPLOAD_DURATION for that
# derivation. rclone SizeSuffix in bytes per second, e.g. 10M. An active
# BW_LIMIT_UP wins over this; empty disables the derivation.
: "${TARGET_UPLOAD_THROUGHPUT:=}"
