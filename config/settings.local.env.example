# Your personal overrides.
#
# Copy this file to settings.local.env (gitignored) and uncomment whatever
# you need. Values here win over both config/settings.env and environment
# variables, so this is the right place for permanent local changes.
# Every setting and its default is documented in docs/settings.md.

# Remote and tuning.
# RCLONE_REMOTE="sciebo"
# REMOTE_BASE="backup"
# RCLONE_CONFIG="$HOME/.config/rclone/rclone.conf"
# TRANSFERS=1
# CHECKERS=2
# TPSLIMIT=4
# RETRIES=3
# LOW_LEVEL_RETRIES=10
# TIMEOUT="10m"
# CONTIMEOUT="30s"
# STATS="30s"
# LOG_LEVEL="INFO"          # DEBUG, INFO, NOTICE, WARNING, or ERROR
# RETRIES_SLEEP="5s"        # delay between high-level retries (empty = rclone default)
# TRANSFER_PARTIAL=1        # keep interrupted downloads for resume (--partial)
# TRANSFER_INPLACE=1        # write directly to the destination (--inplace)

# Refuse rclone binaries older than this; `doctor` and `sync` enforce it.
# RCLONE_MIN_VERSION="1.69"

# Bisync conflict handling and resilience (rclone >= RCLONE_MIN_VERSION).
# BISYNC_CONFLICT_RESOLVE="newer"       # none|newer|older|larger|smaller|path1|path2
# BISYNC_CONFLICT_LOSER="num"           # num|pathname|delete
# BISYNC_CONFLICT_SUFFIX="(conflicted copy)"
# BISYNC_RESILIENT=0                    # 0 stops passing --resilient
# BISYNC_RECOVER=0                      # 0 stops passing --recover
# BISYNC_MAX_LOCK="2m"
# BISYNC_RESYNC_MODE="newer"

# Extra transfer safeguards (see config/settings.env for the defaults).
# BW_LIMIT_UP="2M"          # upload cap (rclone SizeSuffix)
# BW_LIMIT_DOWN="5M"        # download cap
# CREATE_EMPTY_SRC_DIRS=1
# TRACK_RENAMES=1
# MAX_DELETE=100            # -1 means unlimited

# Nextcloud upload chunk size; empty follows the cached server capability.
# CHUNK_SIZE="100Mi"

# Preserve overwritten/deleted local files on pull runs under this directory
# (rclone --backup-dir). Empty (the default) disables the copies.
# BACKUP_DIR="$HOME/.cache/sciebo-backup"

# App password storage: 1 = platform keychain (default; macOS `security`,
# Linux `secret-tool` or `pass`), 0 = obscured password in the rclone config.
# Use 0 when no keychain backend is installed.
# KEYCHAIN=0
# KEYCHAIN_SERVICE="rclone-sciebo"

# How long a cached OCS capabilities probe stays fresh, in seconds.
# CAPABILITIES_MAX_AGE=86400

# Desktop notifications (osascript on macOS, notify-send on Linux): failures
# and conflicts by default, every success too with NOTIFY_SUCCESS=1.
# NOTIFY=0
# NOTIFY_SUCCESS=1

# Scheduled sync (launchd on macOS, systemd --user on Linux; 24h clock
# unless SCHEDULE_INTERVAL is set).
# LAUNCHD_LABEL="de.rclone-sciebo.sync"
# SCHEDULE_HOUR=22
# SCHEDULE_MINUTE=0
# SCHEDULE_INTERVAL=3600    # run every N seconds instead of daily
# SCHEDULE_JITTER=300       # random pre-delay in seconds
# SCHEDULE_WATCH_PATH="$HOME/Projects"

# Folder picker (`sciebo folders`).
# FOLDERS_SCAN_DEPTH=3
# DEFAULT_PAIR_MODE="bisync"
# FOLDERS_LOCAL_ROOT="$HOME/sciebo"

# On-demand mounts (`sciebo mount`).
# MOUNT_ROOT="$HOME/sciebo-mount"
# MOUNT_CACHE_MAX_SIZE="5G"
# MOUNT_FILTERS=0           # 0 stops applying the clutter/pair filters
# MOUNT_NO_SYNC=0           # 0 stops passing --exclude-if-present .nosync
# MOUNT_EXTRA_FLAGS="--dir-cache-time 5m"

# Direct HTTP calls (share, notifications, activity, presence, lock, trash,
# versions) use these for the curl timeout and retries. HTTP_RETRY_DELAY is
# the seconds between retries; GET/HEAD follow up to HTTP_MAX_REDIRS redirects
# when HTTP_FOLLOW_REDIRECTS=1 (writes never follow, so a body is not dropped).
# HTTP_TIMEOUT=60
# HTTP_RETRIES=3
# HTTP_RETRY_DELAY=2
# HTTP_FOLLOW_REDIRECTS=1
# HTTP_MAX_REDIRS=10

# Accept invalid TLS certificates (self-signed setups): rclone gets
# --no-check-certificate, curl gets --insecure. Off by default; prefer
# fixing the certificate.
# TLS_INSECURE=1

# Mutual TLS and custom trust. CLIENT_CERT/CLIENT_KEY are PEM files for the
# client certificate and private key; CLIENT_KEY_PASSWORD is the plaintext
# passphrase for an encrypted key (sciebo obscures it before handing it to
# rclone, since rclone's --client-pass takes an obscured value). CA_CERT is a
# PEM CA bundle used to verify the server. USER_AGENT overrides the HTTP
# User-Agent (empty keeps the rclone/curl default). Paths are checked when
# set and must be readable.
# CLIENT_CERT="$HOME/.config/sciebo/client.pem"
# CLIENT_KEY="$HOME/.config/sciebo/client.key"
# CLIENT_KEY_PASSWORD="key-passphrase"
# CA_CERT="$HOME/.config/sciebo/ca.pem"
# USER_AGENT="sciebo/1.0"

# Hidden files: 0 syncs dot-files and dot-directories (the desktop client
# behavior, the default); 1 excludes them, the nextcloudcmd default.
# SKIP_HIDDEN=1

# Conflicts and the download size guard. CONFLICT_UPLOAD=1 syncs conflict
# copies to the server again (the desktop client keeps them local).
# CONFLICT_UPLOAD=1
# CONFLICT_PATTERN="conflicted copy"
# MAX_DOWNLOAD_SIZE="10G"   # empty (the default) disables the guard
# ASK_DOWNLOAD_SIZE=0       # non-interactive runs then need `sync --yes`

# Failure blacklist (like the desktop client's three-strikes rule).
# BLACKLIST_ENABLED=0
# BLACKLIST_MAX_FAILS=5

# Per-source run history for `sciebo status --history`; 0 disables it.
# HISTORY_MAX_ENTRIES=100

# How many sources one `sciebo sync` run processes at the same time; keep 1
# unless the server can take the extra connections.
# MAX_PARALLEL_SOURCES=2

# Housekeeping (`sciebo cleanup`).
# LOG_RETENTION_DAYS=30
# LOG_MAX_BYTES="10M"       # rotate larger logs to <file>.1; empty disables
# CHUNK_CLEANUP_MIN_AGE="48h"
# STATE_CLEANUP_MIN_AGE="48h"
# JUNK_CLEANUP_MIN_AGE="7d" # globs live in config/filters/fleeting.txt

# Contributing? The test suites override paths through the environment
# instead of this file, so nothing here leaks into a test run. See
# CONTRIBUTING.md.

# Automatic sync (`sciebo watch`).
# WATCH_INTERVAL=30
# WATCH_DEBOUNCE=15
# WATCH_REMOTE_INTERVAL=300   # 0 (default) disables remote-change polling
# WATCH_BACKEND="poll"        # auto|fswatch|inotify|poll

# Start the scheduler agent at login/boot, and render one agent per profile.
# SCHEDULE_AT_LOGIN=1
# SCHEDULE_PROFILES="work personal"

# Bandwidth by time of day (rclone timetable syntax); `sciebo limit` writes
# a temporary cap that wins until it expires.
# BW_SCHEDULE="Mon-Fri 08:00,2M Mon-Fri 18:00,off"

# Metered networks (allow|ask|skip) and extra Wi-Fi names to treat as metered.
# METERED_POLICY="skip"
# METERED_SSIDS="iPhone-Hotspot CafeWifi"

# Disk space guards. The desktop client values are 512M and 1G; empty (the
# default) disables both.
# MIN_FREE_SPACE="512M"
# FREE_SPACE_DOWNLOAD="1G"

# Warn before a run when the server quota is at or above this percentage used
# (integer 0-100; 0 disables). `doctor` reports the same threshold.
# QUOTA_WARN_PERCENT=90

# Proxy: explicit URL, or PROXY_DIRECT=1 to ignore HTTP(S)_PROXY.
# PROXY="http://proxy.example.org:8080"
# PROXY_DIRECT=1

# Layer the server's sync-exclude list under every source, and warn about
# large unconfigured remote folders.
# FILTER_SERVER_SYNC=1
# SERVER_EXCLUDE_MAX_AGE=86400
# BIG_FOLDER_SIZE="5G"
# BIGFOLDER_SCAN_TTL="30m"  # reuse a big-folder scan this long; 0 always scans

# Failure blacklist: "count" (default, three strikes until `sciebo retry`)
# or "backoff" (retry between BLACKLIST_TIME_MIN and BLACKLIST_TIME_MAX).
# BLACKLIST_MODE="backoff"
# BLACKLIST_TIME_MIN=25
# BLACKLIST_TIME_MAX=86400

# 0 matches the desktop client's HTTP/2-off default.
# HTTP2_ENABLED=0

# Server extras.
# SEARCH_LIMIT=50
# RECENT_LIMIT=100
# AVATAR_SIZE=256
# COMMENTS_LIMIT=100
# FILE_ACTIVITY_LIMIT=100

# `sciebo download` writes a bare `download REMOTE` here (empty = the current
# directory); `sciebo preview` requests this many pixels per side and writes
# the image to DEFAULT_PREVIEW_FILE when --output is omitted.
# DOWNLOAD_DIR="$HOME/Downloads"
# PREVIEW_SIZE=512
# DEFAULT_PREVIEW_FILE="./preview"

# `setup --crypt` remote name (default: "<RCLONE_REMOTE>-crypt").
# CRYPT_REMOTE="sciebo-crypt"

# Notification filters (allowlists; empty means all) and the
# `notifications --watch` poll interval.
# NOTIFY_APPS="files_sharing talk"
# NOTIFY_TYPES="file folder"
# NOTIFY_WATCH_INTERVAL=30

# Folder policies: BIG_FOLDER_POLICY is warn|ask|skip for folders above
# BIG_FOLDER_SIZE; BIG_FOLDER_EXISTING_POLICY is warn|skip|allow for sources
# that already exceed it. EXTERNAL_STORAGE_POLICY is allow|warn|ask|skip.
# BIG_FOLDER_POLICY="warn"
# BIG_FOLDER_EXISTING_POLICY="skip"
# EXTERNAL_STORAGE_POLICY="warn"

# Delete guard: prompt (or abort non-interactively) when a run would delete
# more than this many files. `sync --yes` skips the guard for one run.
# DELETE_FILES_THRESHOLD=100
# ASK_DELETE=0

# Move locally deleted/overwritten files on pull/bisync to a local trash
# instead of removing them; if BACKUP_DIR is set it wins.
# MOVE_TO_TRASH=1
# LOCAL_TRASH_DIR="$HOME/.local/share/sciebo/trash"

# Symlinks (skip|follow|translate) and name hygiene policies
# (warn|exclude|allow for invalid names, warn|exclude|rename for case clashes,
# warn|exclude|allow for server-side E2EE folders).
# SYMLINK_POLICY="follow"
# INVALID_NAME_POLICY="warn"
# CASE_CLASH_POLICY="warn"
# CASE_CLASH_REMOTE_SCAN=1   # also scan the remote subtree for case clashes
# E2EE_POLICY="warn"

# Checksum-based comparison where the server supports it.
# CHECKSUM=1

# Proxy mode: system|none|http|socks5 (http and socks5 use PROXY).
# PROXY_TYPE="socks5"
# PROXY="socks5://127.0.0.1:1080"

# Upload chunk bounds; CHUNK_SIZE is clamped to them. When CHUNK_SIZE is
# unset, TARGET_CHUNK_UPLOAD_DURATION (milliseconds, desktop-client units)
# and the throughput target derive a run-level chunk instead.
# MIN_CHUNK_SIZE="5Mi"
# MAX_CHUNK_SIZE="100Mi"
# TARGET_CHUNK_UPLOAD_DURATION=60000
# TARGET_UPLOAD_THROUGHPUT="10M"   # BW_LIMIT_UP wins when set
