# Copy to settings.local.env (gitignored) to override settings.env or the
# environment. Plain assignments win over both. Examples:
#
# RCLONE_REMOTE="sciebo"
# REMOTE_BASE="backup"
# TRANSFERS=1
# LOG_RETENTION_DAYS=30
# SCHEDULE_HOUR=22
# SCHEDULE_MINUTE=0
#
# Folder chooser (`sciebo folders`):
# FOLDERS_SCAN_DEPTH=3
# DEFAULT_PAIR_MODE="bisync"
# FOLDERS_LOCAL_ROOT="$HOME/sciebo"
#
# On-demand mounts (`sciebo mount`):
# MOUNT_ROOT="$HOME/sciebo-mount"
# MOUNT_CACHE_MAX_SIZE="5G"
# MOUNT_EXTRA_FLAGS="--dir-cache-time 5m"
#
# The integration tests use this mechanism to isolate their state:
# - STATE_DIR, MANIFEST_FILE, MANIFEST_GENERATED_FILE, ROOTS_FILE
# - RCLONE_REMOTE, RCLONE_CONFIG
