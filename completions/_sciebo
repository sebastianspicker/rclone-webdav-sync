_sciebo() {
  local state line context
  typeset -A opt_args
  local ret=1

  _arguments -C ${_sciebo_global_specs[@]} \
    '1:command:->command' \
    '*::argument:->args' && ret=0

  case $state in
    command)
      _describe -t commands 'sciebo command' _sciebo_commands
      ;;
    args)
      case $words[1] in
        help)
          _describe -t commands 'sciebo command' _sciebo_commands
          ;;
        setup)
          _arguments ${_sciebo_global_specs[@]} \
            '--login[authenticate with the Nextcloud Login Flow v2]' \
            '--url=[base URL for --login]:url:' \
            '--rotate[fetch a fresh app password for the configured remote]' \
            '--no-keychain[store the obscured password in the rclone config]' \
            '--proxy=[proxy URL for this setup run]:url:' \
            '--crypt[create the crypt remote wrapping the WebDAV remote]'
          ;;
        doctor)
          _arguments ${_sciebo_global_specs[@]} \
            '--offline[skip network checks]' \
            '--json[print a JSON document instead of the text report]'
          ;;
        discover)
          _arguments ${_sciebo_global_specs[@]} '--write[write config/sources.generated.conf]'
          ;;
        list)
          _arguments ${_sciebo_global_specs[@]} \
            '--json[print the valid sources as JSON]'
          ;;
        check | sync)
          _arguments ${_sciebo_global_specs[@]} \
            '--apply[transfer data]' \
            '--dry-run[explicit dry run]' \
            '--only=[run only this source]:source name:' \
            '--resync[allow rclone bisync --resync]' \
            '--yes[ignore the MAX_DOWNLOAD_SIZE and delete guards]' \
            '--metered-ok[run even on a metered connection]' \
            '--quiet[only print failures, warnings, and the summary]' \
            '--no-lock[do not take the run lock]' \
            '--force[run even while paused]'
          ;;
        verify)
          _arguments ${_sciebo_global_specs[@]} \
            '--only=[check only this source]:source name:' \
            '--download[download remote files and hash them]' \
            '--size-only[compare sizes only, skip hashes]' \
            '--quiet[only print failures and the summary]'
          ;;
        status)
          _arguments ${_sciebo_global_specs[@]} \
            '--only=[show only this source]:source name:' \
            '--history=[print the last N recorded runs]:N:' \
            '--json[print the report as JSON]' \
            '--watch=[refresh the report every N seconds]:N:' \
            '--quiet[only print rows that need attention]'
          ;;
        pause)
          _arguments ${_sciebo_global_specs[@]} '--for=[pause for this long]:duration:'
          ;;
        resume)
          _arguments ${_sciebo_global_specs[@]}
          ;;
        folders)
          _sciebo_folders
          ;;
        mount)
          _arguments ${_sciebo_global_specs[@]} \
            '--folder=[remote subfolder below the remote base]:remote subfolder:' \
            '--mountpoint=[local mountpoint]:mountpoint:_directories' \
            '--ro[read-only mount, no VFS cache]' \
            '--foreground[run rclone in the foreground]' \
            '--sudo[run rclone as root]'
          ;;
        umount)
          _arguments ${_sciebo_global_specs[@]} \
            '--folder=[unmount the mount for this remote subfolder]:remote subfolder:' \
            '--mountpoint=[unmount the mount for this local mountpoint]:mountpoint:_directories' \
            '--all[unmount every recorded mount]' \
            '--sudo[run umount as root]'
          ;;
        mounts)
          _arguments ${_sciebo_global_specs[@]} \
            '--folder=[only show this remote subfolder]:remote subfolder:' \
            '--check[exit 1 when a recorded mount is not visible]' \
            '--prune[remove stale mount records]' \
            '--json[print the mounts as JSON]'
          ;;
        cleanup)
          _arguments ${_sciebo_global_specs[@]} \
            '--logs[delete old log files and rotate large ones]' \
            '--uploads[delete stale chunk uploads]' \
            '--state[delete stale bisync, lock, temp, and mount state]' \
            '--junk[delete files matching fleeting.txt]' \
            '--cache[delete stale mount-cache files]' \
            '--support[keep the newest support archives]' \
            '--keep=[archives to keep for --support]:N:' \
            '--apply[actually delete (default is a dry run)]'
          ;;
        schedule)
          _sciebo_schedule
          ;;
        trash)
          _sciebo_trash
          ;;
        versions)
          _arguments ${_sciebo_global_specs[@]} \
            '1:remote path:' \
            '--download=[save this version]:version:' \
            '--output=[write the --download body to FILE]:file:_files' \
            '--stdout[stream the --download body to standard output]' \
            '--restore=[restore this version]:version:' \
            '--delete=[delete this version]:version:' \
            '--yes[skip the --restore/--delete confirmation]'
          ;;
        share)
          _sciebo_share
          ;;
        notifications)
          _arguments ${_sciebo_global_specs[@]} \
            '--limit=[print and notify at most N notifications]:N:' \
            '--app=[only notifications from these apps]:list:' \
            '--type=[only notifications with these object types]:list:' \
            '--unseen[only notifications not yet in the seen cache]' \
            '--action=[run an action on a notification]:id label:' \
            '--delete=[delete one notification]:id:' \
            '--delete-all[delete every notification]' \
            '--notify[send a notification per new notification]' \
            '--json[print the filtered notifications as JSON]' \
            '--watch=[poll every N seconds]:seconds:' \
            '--quiet[print no notification rows]' \
            '--yes[skip the --delete-all confirmation]'
          ;;
        activity)
          _arguments ${_sciebo_global_specs[@]} \
            '--limit=[print and notify at most N activities]:N:' \
            '--since=[only activities newer than DURATION (paged)]:duration:' \
            '--notify[send a notification per new activity]' \
            '--quiet[print no activity rows]'
          ;;
        presence)
          _sciebo_presence
          ;;
        lock)
          _arguments ${_sciebo_global_specs[@]} '1:remote file:'
          ;;
        unlock)
          _arguments ${_sciebo_global_specs[@]} \
            '::remote file:' \
            '--all[release every recorded lock]' \
            '--yes[skip the --all confirmation]'
          ;;
        locks)
          _arguments ${_sciebo_global_specs[@]} \
            '--prune[forget records whose lock-token is gone]' \
            '--unlock-all[release every recorded lock]' \
            '--yes[skip the --unlock-all confirmation]'
          ;;
        quota)
          _arguments ${_sciebo_global_specs[@]} '--json[print rclone JSON output]'
          ;;
        open)
          _arguments ${_sciebo_global_specs[@]} \
            '::remote path, local path, or name:_files' \
            '--print[print the resolved path or URL instead of opening it]' \
            '--web[open the folder in the Nextcloud web UI]'
          ;;
        conflicts)
          _arguments ${_sciebo_global_specs[@]} \
            '--resolve=[resolve conflict files instead of listing]:mode:(keep-local keep-remote keep-newest keep-oldest keep-both)' \
            '--only=[scan or resolve only this source]:source name:' \
            '--kind=[scan or resolve only one conflict kind]:kind:(copy case all)' \
            '--open[open the conflict directories with the platform opener]' \
            '--apply[carry out the planned actions]' \
            '--yes[skip the --apply confirmation]' \
            '--json[print the resolve result as JSON]' \
            '--quiet[print nothing; exit 1 when conflict files exist]'
          ;;
        retry)
          _arguments ${_sciebo_global_specs[@]} \
            '::source name:' \
            '::path:' \
            '--list[show all blacklist records and exit]' \
            '--all[clear every source records]'
          ;;
        account)
          _sciebo_account
          ;;
        logout)
          _arguments ${_sciebo_global_specs[@]} \
            '--revoke[revoke the app password on the server first]' \
            '--yes[do not ask for confirmation]'
          ;;
        config)
          _sciebo_config
          ;;
        support)
          _arguments ${_sciebo_global_specs[@]} \
            '--output=[archive path]:file:_files' \
            '--no-network[accepted for compatibility; doctor runs offline]' \
            '--json[print the archive summary as JSON]'
          ;;
        nextcloudcmd)
          _arguments ${_sciebo_global_specs[@]} \
            '1:SOURCEDIR:_directories' \
            '2:NEXTCLOUDURL:' \
            '--path=[remote folder below the user root]:subfolder:' \
            '--confdir=[configuration base for this run]:directory:_directories' \
            '--user=[user name]:user:' \
            '-u[user name]:user:' \
            '--password=[password]:password:' \
            '-p[password]:password:' \
            '--password-fd=[read the password from an already-open file descriptor]:fd:' \
            '-n[read credentials from ~/.netrc]' \
            '--silent[errors only]' \
            '-s[errors only]' \
            '--httpproxy=[HTTP proxy URL]:url:' \
            '--exclude=[read exclude patterns from FILE]:file:_files' \
            '--exclude-anchored=[read sync-root patterns from FILE]:file:_files' \
            '--unsyncedfolders=[exclude every folder listed in FILE]:file:_files' \
            '--max-sync-retries=[retry the whole sync up to N times]:N:' \
            '--uplimit=[upload bandwidth cap]:rate:' \
            '--downlimit=[download bandwidth cap]:rate:' \
            '--logdebug[debug-level logging]' \
            '--verbose[debug-level logging]' \
            '--progress[show rclone transfer progress (terminal only)]' \
            '-P[show rclone transfer progress (terminal only)]' \
            '-v[print the version and exit]' \
            '--version[print the version and exit]' \
            '-h[sync hidden files]' \
            '--dry-run[report what would change, change nothing]'
          ;;
        watch)
          _arguments ${_sciebo_global_specs[@]} \
            '--interval=[poll interval in seconds]:seconds:' \
            '--debounce=[coalesce change events for N seconds]:seconds:' \
            '*--only=[watch only this source]:source name:' \
            '--remote-interval=[check the remote every N seconds]:seconds:' \
            '--backend=[change-detection backend]:backend:(auto fswatch inotify poll)' \
            '--once[run one detection cycle and exit]' \
            '--notify[allow desktop notifications]' \
            '--no-notify[disable desktop notifications even when NOTIFY=1]' \
            '--quiet[only warnings and errors]'
          ;;
        limit)
          _arguments ${_sciebo_global_specs[@]} \
            '--up=[upload cap, e.g. 2M]:rate:' \
            '--down=[download cap, e.g. 5M]:rate:' \
            '--until=[expire after this long]:duration:' \
            '--show[print the current limit]' \
            '--clear[remove the marker]' \
            '--json[print the state as JSON]'
          ;;
        unlimited)
          _arguments ${_sciebo_global_specs[@]}
          ;;
        network)
          _arguments ${_sciebo_global_specs[@]} '--json[print the state as JSON]'
          ;;
        filters)
          _sciebo_filters
          ;;
        file)
          _sciebo_file
          ;;
        search)
          _arguments ${_sciebo_global_specs[@]} \
            '1:TERM:' \
            '--limit=[ask the server for at most N results]:N:' \
            '--json[print the results as JSON]' \
            '--open[open the first result with the platform opener]'
          ;;
        recent)
          _arguments ${_sciebo_global_specs[@]} \
            '--since=[only files modified within DURATION]:duration:' \
            '--limit=[print at most N files]:N:' \
            '--json[print the files as JSON]'
          ;;
        comments)
          _arguments ${_sciebo_global_specs[@]} \
            '1:remote path:' \
            '2:action:(list add delete)' \
            '3:argument:' \
            '--json[print the listing as JSON]' \
            '--yes[skip the delete confirmation]'
          ;;
        favorites)
          _arguments ${_sciebo_global_specs[@]} \
            '1:subcommand:(list add remove)' \
            '2:remote path:' \
            '--json[print the listing as JSON]'
          ;;
        tags)
          _sciebo_tags
          ;;
        server)
          _sciebo_server
          ;;
        hydrate)
          _arguments ${_sciebo_global_specs[@]} \
            '1:remote path:' \
            '--dest=[copy into DIR instead of the resolved destination]:directory:_directories' \
            '--dry-run[report what would be copied; changes nothing]' \
            '--quiet[do not print the success line]' \
            '--json[print the result as JSON]' \
            '--progress[show rclone transfer progress (terminal only)]'
          ;;
        provision)
          _arguments ${_sciebo_global_specs[@]} \
            '--userid=[Nextcloud user id]:user id:' \
            '--apppassword=[app password]:password:' \
            '--apppassword-fd=[read the app password from this open file descriptor]:fd:' \
            '--serverurl=[server base URL]:url:' \
            '--localdirpath=[local folder to pair]:directory:_directories' \
            '--remotedirpath=[remote folder below the remote base]:remote subfolder:' \
            '--isvfsenabled=[desktop compatibility flag; 1 warns and is ignored]:(0 1)' \
            '--profile=[profile to create or update]:profile:_sciebo_profiles'
          ;;
        logs)
          _sciebo_logs
          ;;
        edit)
          _arguments ${_sciebo_global_specs[@]} \
            '1:remote file:' \
            '--editor=[editor command, possibly with arguments]:command:' \
            '--no-upload[do not upload after editing]' \
            '--lock[take a WebDAV lock while editing]'
          ;;
        ignored)
          _arguments ${_sciebo_global_specs[@]} \
            '::local, local-relative, or remote-relative prefix:' \
            '--source=[restrict the scan to one source]:source name:' \
            '--json[print the ignored files as JSON]'
          ;;
        announcements)
          _arguments ${_sciebo_global_specs[@]} \
            '--limit=[print at most N announcements]:N:' \
            '--no-dismiss[accepted for compatibility]' \
            '--json[print the announcements as JSON]'
          ;;
        preview)
          _arguments ${_sciebo_global_specs[@]} \
            '1:remote file:' \
            '--output=[write the image to FILE]:file:_files' \
            '--size=[preview edge size in pixels]:pixels:'
          ;;
        download)
          _arguments ${_sciebo_global_specs[@]} \
            '1:remote path:' \
            '2:destination:' \
            '--dry-run[report what would be transferred; change nothing]' \
            '--force[download even when the destination matches]' \
            '--resume[continue a partial file]' \
            '--continue[continue a partial file]' \
            '--quiet[do not print the success line]' \
            '--json[print a structured summary]' \
            '--progress[show rclone transfer progress (terminal only)]'
          ;;
        update)
          _arguments ${_sciebo_global_specs[@]} \
            '--check[only report the local vs upstream state]' \
            '--json[print the report as JSON]'
          ;;
      esac
      ;;
  esac

  return ret
}

_sciebo "$@"
