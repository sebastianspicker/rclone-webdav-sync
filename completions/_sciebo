#compdef sciebo
#
# zsh completion for the sciebo CLI. Put this file on $fpath as `_sciebo`;
# compinit then picks it up automatically. The command list mirrors
# COMMANDS in bin/sciebo; the option lists mirror the usage_* functions in
# lib/commands/*.sh.

typeset -ga _sciebo_global_specs
_sciebo_global_specs=(
  '(-h --help)'{-h,--help}'[show help]'
  '--profile=[select a profile]:profile:_sciebo_profiles'
  '--trust[accept invalid TLS certificates]'
  '--non-interactive[never prompt; fail or skip instead]'
  '--debug[verbose rclone/HTTP output]'
  '--log-file=[write the rclone log here]:file:_files'
  '--confdir=[configuration and state directory]:directory:_directories'
  '--log-dir=[write run logs here]:directory:_directories'
  '--log-expire=[delete logs older than this many hours]:hours:'
  '(-V --version)'{-V,--version}'[show the version]'
)

typeset -ga _sciebo_commands
_sciebo_commands=(
  'setup:create/update the sciebo rclone remote'
  'doctor:preflight checks (PASS/WARN/FAIL report)'
  'discover:find git repositories under roots.conf'
  'list:list configured sources'
  'check:dry run of all sources'
  'sync:apply sync/pull/bisync for all sources'
  'verify:check that sources match their destinations'
  'status:last run per source, plus the pause state'
  'pause:skip sync/check runs until resumed'
  'resume:clear the pause marker'
  'folders:choose/add/list/edit/remove folder pairs'
  'mount:mount the remote on demand (nfsmount)'
  'umount:unmount a recorded mount'
  'mounts:show recorded mounts'
  'cleanup:old logs / stale chunk-upload housekeeping'
  'schedule:install/uninstall/status of the launchd agent'
  'trash:list/restore/remove/empty the Nextcloud trashbin'
  'versions:list/download/restore/delete file versions'
  'share:create, list, update, or remove Nextcloud shares'
  'notifications:list or delete Nextcloud notifications'
  'activity:show the Nextcloud activity stream'
  'presence:show or set your Nextcloud user status'
  'lock:lock a remote file (WebDAV)'
  'unlock:unlock a remote file (WebDAV)'
  'locks:list locks recorded by sciebo lock'
  'quota:show server quota usage'
  'open:open a local sync folder'
  'conflicts:find local conflict copies'
  'retry:clear failure-blacklist entries'
  'account:manage profiles (list/add/remove/use/info/avatar)'
  'logout:remove credentials for the active remote'
  'config:show effective settings and their source'
  'support:build a redacted debug archive'
  'nextcloudcmd:nextcloudcmd-compatible single sync run'
  'watch:run sync when local files change'
  'limit:cap bandwidth for later runs'
  'unlimited:lift the bandwidth cap'
  'network:show the active network and metered state'
  'filters:manage filter files (sync/list/show/check)'
  'file:file details, activity, and shares'
  'search:unified search on the server'
  'recent:recently modified remote files'
  'comments:file comments (Nextcloud comments app)'
  'favorites:list or toggle server-side favorites'
  'tags:list system tags and assign them'
  'server:server information and capabilities'
  'hydrate:download a remote path on demand'
  'provision:non-interactive account and folder setup'
  'logs:list, show, or tail per-source sync logs'
  'edit:download, edit, and upload one remote file'
  'ignored:list files excluded from syncing'
  'announcements:list server announcements'
  'preview:download a preview image for a remote file'
  'download:download a remote file or directory'
  'update:update the local checkout from git'
  'help:show help for a command'
)

_sciebo_project_root() {
  local dir=${${(%):-%x}:A:h:h}
  [[ -d $dir/config ]] && print -r -- $dir
}

_sciebo_profiles() {
  local root
  local -a profiles names
  profiles=(default)
  root=$(_sciebo_project_root)
  if [[ -n $root && -d $root/config/profiles ]]; then
    names=(${(f)"$(command ls -1 $root/config/profiles 2>/dev/null)"})
    profiles+=(${names:#})
  fi
  _describe -t profiles 'profile' profiles
}

_sciebo_folders() {
  local state
  typeset -A opt_args
  _arguments -C ${_sciebo_global_specs[@]} \
    '1:subcommand:->sub' \
    '*::argument:->args' && return 0
  case $state in
    sub)
      local -a subs
      subs=(
        'choose:browse the remote and pick folders (default)'
        'add:add a single pair without browsing'
        'import:add a pair from a nextcloudcmd --unsyncedfolders list'
        'edit:rewrite a wizard pair subfolder filter or mode'
        'list:table of all configured pairs'
        'pause:skip a pair in sync/check'
        'resume:clear a pair paused flag'
        'remove:remove a wizard-managed pair from folders.conf'
      )
      _describe -t commands 'folders subcommand' subs
      ;;
    args)
      case $words[1] in
        choose)
          _arguments ${_sciebo_global_specs[@]} \
            '--depth=[remote scan depth]:depth:' \
            '--local-root=[local root for default destinations]:directory:_directories' \
            '--mode=[fix the direction for all picks]:mode:(sync pull bisync)' \
            '--select[pick which subfolders to sync]' \
            '--no-fzf[always use the numbered menu]' \
            '--no-dry-run[do not offer a dry run after adding pairs]'
          ;;
        add)
          _arguments ${_sciebo_global_specs[@]} \
            '--remote=[remote subfolder below the remote base]:remote subfolder:' \
            '--local=[local path]:path:_files' \
            '--mode=[direction]:mode:(sync pull bisync)' \
            '--select[interactively pick subfolders to sync]' \
            '*--include=[sync only this subfolder below --remote]:subfolder:' \
            '*--exclude=[exclude this subfolder]:subfolder:' \
            '--local-root=[local root for the default destination]:directory:_directories'
          ;;
        import)
          _arguments ${_sciebo_global_specs[@]} \
            '1:FILE:_files' \
            '--remote=[remote subfolder below the remote base]:remote subfolder:' \
            '--local=[local path]:path:_files' \
            '--mode=[direction]:mode:(sync pull bisync)' \
            '--local-root=[local root for the default destination]:directory:_directories' \
            '--select[sync only the listed folders]'
          ;;
        edit)
          _arguments ${_sciebo_global_specs[@]} \
            '1:NAME:' \
            '--local=[replace the local folder]:path:_files' \
            '--remote=[replace the remote subfolder]:remote subfolder:' \
            '--force[allow a remote change with stale bisync state]' \
            '*--include=[sync only these immediate subfolders]:subfolder:' \
            '*--exclude=[exclude this subfolder]:subfolder:' \
            '--mode=[change the direction]:mode:(sync pull bisync)' \
            '--select[interactively pick subfolders to sync]' \
            '--clear[remove the pair filter (no rules)]'
          ;;
        list)
          _arguments ${_sciebo_global_specs[@]} '--json[print the pairs as JSON]'
          ;;
        pause | resume)
          _arguments ${_sciebo_global_specs[@]} '1:pair name:'
          ;;
        remove)
          _arguments ${_sciebo_global_specs[@]} '1:NAME:' '--purge[also delete the pair state and filter]'
          ;;
      esac
      ;;
  esac
}

