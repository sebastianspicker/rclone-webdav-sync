#!/usr/bin/env bash
# sciebo - the single entrypoint of rclone-webdav-sync (the `sciebo` command).
#
# Requires Bash 5.3 or newer: modules use associative arrays, mapfile, namerefs,
# case conversion, forkless command substitution, and BASH_MONOSECONDS. macOS
# ships an older bash as /bin/bash, so install a newer bash (e.g.
# `brew install bash`) and make sure it is first on PATH; the guard below fails
# fast with a clear message.
#
# Contracts:
#   - Command functions return a status; only die/usage_error exit.
#   - Commands never call each other in-process; spawn ${PROJECT_DIR}/bin/sciebo.
#   - The EXIT trap releases the run lock; commands acquire it once.
#   - Commands source only the lib/ helpers, never each other's internals.
#
# The entrypoint logic (global options, dispatch, help, traps) lives in
# lib/cli/main.sh's sciebo_main, loaded eagerly below along with every other
# rank 1-6 library (see docs/architecture.md#layers); this script only
# resolves its own path and hands off.

# shellcheck source-path=SCRIPTDIR
set -euo pipefail
umask 077

if ! ((BASH_VERSINFO[0] > 5 || (BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] >= 3))); then
  printf 'sciebo requires Bash 5.3 or newer; found %s.\n' "${BASH_VERSION:-unknown}" >&2
  printf 'Install a newer bash (macOS: brew install bash) and put it first on PATH.\n' >&2
  exit 1
fi

# Resolve this script's directory without a dirname(1) exec, mirroring
# LIB_DIR in lib/base/core.sh: a BASH_SOURCE without a "/" is prefixed with
# "./" so ${...%/*} yields ".". Plain pwd (logical) is kept deliberately —
# the old `cd "$(dirname ...)" && pwd` was logical too, and core.sh's
# LIB_DIR comment relies on both staying in step, so a checkout reached
# through symlinks resolves exactly as before.
_self="${BASH_SOURCE[0]}"
[[ $_self == */* ]] || _self="./$_self"
SCRIPT_DIR="$(cd "${_self%/*}" && pwd)"
unset _self

# lib/sciebo.sh resolves LIB_DIR/PROJECT_DIR and sources every ranked
# lib/*/*.sh file eagerly (~18ms; see docs/architecture.md), including
# lib/cli/main.sh's sciebo_main.
# shellcheck source=../lib/sciebo.sh
source "${SCRIPT_DIR}/../lib/sciebo.sh"

sciebo_main "$@"
